# MyFiles configuration. Copy to .env and edit.
# Every setting can also be given as an environment variable of the same name.

# ---- Storage --------------------------------------------------------------
# Directory where uploaded files are kept (created if missing).
# Must be writable by the user MyFiles runs as.
STORAGE_PATH=/srv/myfiles

# ---- MariaDB --------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=myfiles
DB_USER=myfiles
DB_PASSWORD=change-me
# Connect through a Unix socket instead of TCP (overrides DB_HOST/DB_PORT):
# DB_SOCKET=/run/mysqld/mysqld.sock

# ---- Branding ---------------------------------------------------------------
# Name shown on the login screen, in the header and in the browser tab.
APP_NAME=MyFiles

# ---- Public address -------------------------------------------------------
# The address people use to reach MyFiles, without a trailing slash.
# Share links are built from it: BASE_URL/<random code>.
# Examples: https://myfiles.example.com   or   https://example.com/files
BASE_URL=https://myfiles.example.com

# ---- Web server -----------------------------------------------------------
# Listen on localhost only; Apache forwards requests to it.
HOST=127.0.0.1
PORT=8000
# Proxies allowed to set X-Forwarded-For / X-Forwarded-Proto (comma-separated).
TRUSTED_PROXIES=127.0.0.1

# ---- Accounts -------------------------------------------------------------
# open   = anyone who can reach the site can register
# invite = registering requires INVITE_CODE
# closed = no registration; add users with: python -m myfiles create-user NAME
REGISTRATION_MODE=invite
INVITE_CODE=pick-something-secret

SESSION_LIFETIME_DAYS=30
# Mark the login cookie "Secure": auto = when the request came in over HTTPS.
COOKIE_SECURE=auto

# ---- Uploads --------------------------------------------------------------
# Largest allowed upload in MB (0 = no limit).
MAX_UPLOAD_SIZE_MB=0

# ---- Storage quotas -------------------------------------------------------
# Storage each user gets unless an administrator sets a different quota for them,
# in GB (0 = unlimited). Change it any time; restart MyFiles to apply it.
DEFAULT_QUOTA_GB=15
